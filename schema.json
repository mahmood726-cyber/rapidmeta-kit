{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "rapidmeta-kit clone config",
  "type": "object",
  "required": ["drug", "slug", "condition", "title", "trials"],
  "properties": {
    "drug": { "type": "string", "minLength": 1 },
    "drug_lower": { "type": "string" },
    "slug": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "condition": { "type": "string", "minLength": 1 },
    "comparator": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "hero_h2": { "type": "string" },
    "nyt_headline": { "type": "string" },
    "canonical_url": { "type": "string", "description": "Published URL of this dashboard for JSON-LD provenance. Default: <slug>.html (relative)." },
    "publisher_url": { "type": "string", "description": "JSON-LD publisher org URL. Default: the rapidmeta-kit Pages site." },
    "orcid": { "type": "string", "description": "Author ORCID (id or full URL). Omit to drop the empty identifier." },
    "repo": { "type": "string", "description": "owner/repo cited in the help text. Default: mahmood726-cyber/rapidmeta-kit." },
    "pico": {
      "type": "object",
      "properties": {
        "pop": { "type": "string" }, "int": { "type": "string" },
        "comp": { "type": "string" }, "out": { "type": "string" },
        "subgroup": { "type": "string" }
      }
    },
    "acronyms": { "type": "object" },
    "trials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["nct", "name"],
        "properties": {
          "nct": { "type": "string" },
          "name": { "type": "string" },
          "pmid": { "type": "string" },
          "phase": { "type": "string" },
          "year": { "type": "integer" },
          "group": { "type": "string" },
          "tE": { "type": ["integer", "null"] },
          "tN": { "type": ["integer", "null"] },
          "cE": { "type": ["integer", "null"] },
          "cN": { "type": ["integer", "null"] },
          "publishedHR": { "type": ["number", "null"] },
          "hrLCI": { "type": ["number", "null"] },
          "hrUCI": { "type": ["number", "null"] },
          "allOutcomes": { "type": "array" }
        }
      }
    }
  }
}
